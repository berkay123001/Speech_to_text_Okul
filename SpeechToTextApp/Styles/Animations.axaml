<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Button#MicrophoneButton.listening">
        <Setter Property="RenderTransform" Value="scale(1.15, 1.15)"/>
    </Style>

    <Style Selector="Ellipse#PulseCircle.listening">
        <Setter Property="Opacity" Value="0.3"/>
    </Style>

    <Style Selector="TextBlock.fade-in-up">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="RenderTransform" Value="translateY(10px)"/>
        <Style.Animations>
            <Animation Duration="0:0:0.5" Easing="EaseInOutCubic">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="RenderTransform" Value="translateY(10px)"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="RenderTransform" Value="translateY(0)"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

</Styles>
