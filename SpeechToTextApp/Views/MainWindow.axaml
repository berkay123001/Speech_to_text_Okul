<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpeechToTextApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SpeechToTextApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Speech-to-Text App">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <StackPanel Spacing="10" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Recognized Text:" FontWeight="Bold" FontSize="16"/>
        <ScrollViewer Height="200" Width="600" BorderBrush="Gray" BorderThickness="1">
            <TextBlock Text="{Binding RecognizedText}"
                       TextWrapping="Wrap"
                       Margin="5"
                       MinWidth="580"/>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="🎙️ Start Listening"
                    Command="{Binding StartListeningCommand}"
                    IsEnabled="{Binding !IsListening}"
                    Width="150" Height="40"/>
            <Button Content="🛑 Stop"
                    Command="{Binding StopListeningCommand}"
                    IsEnabled="{Binding IsListening}"
                    Width="150" Height="40"/>
        </StackPanel>
    </StackPanel>

</Window>
