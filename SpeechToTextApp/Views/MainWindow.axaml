<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpeechToTextApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="SpeechToTextApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SpeechFlow"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True">

    <Window.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#2D2D2D" Offset="0.0" />
            <GradientStop Color="#1E1E1E" Offset="1.0" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid RowDefinitions="*,Auto" Margin="20">
        <Border Grid.Row="0"
                Background="#3C3C3C"
                CornerRadius="15"
                Margin="10"
                BoxShadow="0 5 15 0 #111">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding TranscriptWords}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Margin="15"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontSize="18"
                                       Foreground="White"
                                       Margin="3"
                                       Classes="fade-in-up"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Canvas Grid.Row="1"
                Width="100" Height="50"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                IsVisible="{Binding IsListening}"
                Margin="0,0,0,10">
            <!-- Simple animated waveform -->
            <Rectangle Fill="White" Width="8" Height="30" Canvas.Left="0" RenderTransformOrigin="50%,50%" Classes.listening="{Binding IsListening}">
                <Rectangle.Styles>
                    <Style Selector="Rectangle.listening">
                        <Style.Animations>
                            <Animation Duration="0:0:1.2" IterationCount="Infinite" PlaybackDirection="Alternate">
                                <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleY" Value="0.3"/></KeyFrame>
                                <KeyFrame Cue="50%"><Setter Property="ScaleTransform.ScaleY" Value="1.0"/></KeyFrame>
                                <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleY" Value="0.3"/></KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Rectangle.Styles>
            </Rectangle>
             <Rectangle Fill="White" Width="8" Height="30" Canvas.Left="20" RenderTransformOrigin="50%,50%" Classes.listening="{Binding IsListening}">
                <Rectangle.Styles>
                    <Style Selector="Rectangle.listening">
                        <Style.Animations>
                            <Animation Duration="0:0:1.4" IterationCount="Infinite" PlaybackDirection="Alternate">
                                <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleY" Value="0.4"/></KeyFrame>
                                <KeyFrame Cue="50%"><Setter Property="ScaleTransform.ScaleY" Value="0.8"/></KeyFrame>
                                <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleY" Value="0.4"/></KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Rectangle.Styles>
            </Rectangle>
             <Rectangle Fill="White" Width="8" Height="30" Canvas.Left="40" RenderTransformOrigin="50%,50%" Classes.listening="{Binding IsListening}">
                <Rectangle.Styles>
                    <Style Selector="Rectangle.listening">
                        <Style.Animations>
                            <Animation Duration="0:0:1.0" IterationCount="Infinite" PlaybackDirection="Alternate">
                                <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleY" Value="0.2"/></KeyFrame>
                                <KeyFrame Cue="50%"><Setter Property="ScaleTransform.ScaleY" Value="0.9"/></KeyFrame>
                                <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleY" Value="0.2"/></KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Rectangle.Styles>
            </Rectangle>
        </Canvas>

        <Grid Grid.Row="1" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Name="PulseCircle"
                     Width="100"
                     Height="100"
                     Fill="#4A4A4A"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Classes.listening="{Binding IsListening}">
                <Ellipse.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.8" Easing="EaseInOutCubic"/>
                    </Transitions>
                </Ellipse.Transitions>
            </Ellipse>

            <Button Name="MicrophoneButton"
                    Command="{Binding StartListeningCommand}"
                    IsVisible="{Binding !IsListening}"
                    Classes.listening="{Binding IsListening}"
                    Width="80" Height="80"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="40"
                    Background="#5A5A5A"
                    BorderThickness="0">
                <TextBlock Text="🎙️" FontSize="36"/>
                <Button.Transitions>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.8" Easing="EaseInOutCubic"/>
                    </Transitions>
                </Button.Transitions>
            </Button>

            <Button Command="{Binding StopListeningCommand}"
                    IsVisible="{Binding IsListening}"
                    Width="80" Height="80"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="40"
                    Background="#7A7A7A"
                    BorderThickness="0">
                <TextBlock Text="🛑" FontSize="36"/>
            </Button>
        </Grid>
        <Button Grid.Row="1"
                Content="Clear"
                Command="{Binding ClearTranscriptCommand}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Background="#4A4A4A"
                Foreground="White"
                CornerRadius="5"
                BorderThickness="0"/>
    </Grid>
</Window>
